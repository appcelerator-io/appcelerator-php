{
    "name": "appcelerator/appcelerator-php",
    "description": "AppCelerator PHP SDK",
    "keywords": [
        "appcelerator",
        "apis",
        "api"
    ],
    "homepage": "https://appcelerator.io/",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "AppCelerator and contributors",
            "homepage": "https://github.com/appcelerator-io/appcelerator-php/contributors"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "friendsofphp/php-cs-fixer": "3.5.0",
        "phpstan/phpstan": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "AppCelerator\\": "src/"
        }
    },
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload-dev": {
        "psr-4": {
            "AppCelerator\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "ext-apcu": "Caches tokens in APCu, shared by the php-fpm workers (otherwise a file in the temp directory)"
    },
    "scripts": {
        "test": "phpunit"
    }
}
